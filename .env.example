# Insert the public deployment origin for absolute social sharing URLs.
NEXT_PUBLIC_SITE_URL=
# Insert the three real Joscity URLs. Never use invented store listings.
NEXT_PUBLIC_JOSCITY_WEBSITE_URL=https://joscity.com
NEXT_PUBLIC_JOSCITY_ANDROID_URL=https://play.google.com/store/apps/details?id=com.joscity.app&pcampaignid=web_share
NEXT_PUBLIC_JOSCITY_IOS_URL=https://apps.apple.com/ng/app/joscity/id6805214004
# Served from public/audio so the browser can play it. Set to off to disable music.
NEXT_PUBLIC_MUSIC_SRC=/audio/invitation.mp3

# Server-only Cloudinary credentials and SIGNED preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=mm26_guest_memories
# Supabase PostgreSQL session-pooler connection string (server-only).
DATABASE_URL=
GALLERY_MAX_UPLOAD_MB=100
# Local testing only; keep false in production.
GALLERY_ALLOW_EARLY_UPLOADS=false
